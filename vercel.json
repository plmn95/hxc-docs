{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run check",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    {
      "source": "/edit/:path*/",
      "destination": "https://plmn95.github.io/hxc-docs/edit/:path*/",
      "permanent": false
    },
    {
      "source": "/edit/:path*",
      "destination": "https://plmn95.github.io/hxc-docs/edit/:path*",
      "permanent": false
    },
    {
      "source": "/vizard-docs/releases/:version",
      "destination": "/vizard-docs/releases/:version/",
      "permanent": true
    },
    {
      "source": "/vizard-docs/releases/:version/:page((?:[^./]+/)*[^./]+)",
      "destination": "/vizard-docs/releases/:version/:page/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://vizard-doc-suggestions.plmn9595.workers.dev https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/_astro/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vizard-docs/releases/:path*/index.html",
      "destination": "/api/archive?archivePath=:path*/index.html"
    },
    {
      "source": "/vizard-docs/releases/:path*/",
      "destination": "/api/archive?archivePath=:path*/"
    },
    {
      "source": "/vizard-docs/releases/:path*",
      "destination": "https://plmn95.github.io/hxc-docs/releases/:path*"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/scope-capture-docs": false
    }
  }
}
